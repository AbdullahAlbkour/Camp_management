APP_NAME="Camps Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=camps_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Turn on behind HTTPS so the session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Attachments are private and served only through the application.
FILESYSTEM_DISK=local

# Cost factor for password hashing. Raise it on production hardware.
BCRYPT_ROUNDS=12

# Password reset links are mailed. "log" writes them to the log file, which is
# fine locally; point this at smtp before anyone outside the team needs one.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=noreply@camp.local
MAIL_FROM_NAME="${APP_NAME}"

# Password given to the seeded demo accounts. Change it before any real deployment.
SEED_PASSWORD=Camp-Demo-2026
